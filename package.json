{
  "name": "signal-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Daily radar for demand signals: people asking for tools, willing to pay, bounties, and new launches. Sends a digest to your phone.",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node src/index.ts run",
    "demo": "node src/index.ts run --fixtures --dry-run --no-ai",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0"
  }
}
