# Copy to .env for local runs. In GitHub Actions, add these as repository secrets instead.

# Optional: lets Claude read each post and judge whether it's real, paid-for pain (~pennies/day with Haiku)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# GitHub search (Actions provides GITHUB_TOKEN automatically; locally use a fine-grained token with no scopes)
GITHUB_TOKEN=

# Stack Exchange: optional key raises the daily quota from 300 to 10,000 requests
STACKEXCHANGE_KEY=

# Bluesky: create an app password at bsky.app > Settings > Privacy and security > App passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Reddit needs no keys: it's read via public RSS, off by default, personal use only (docs/SOURCES.md)

# Notifications: set any one or more (Telegram recommended)
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Link in the notification opens today's digest on GitHub (set automatically in Actions)
# DIGEST_BASE_URL=https://github.com/<you>/signal-radar/blob/main/data/digests
